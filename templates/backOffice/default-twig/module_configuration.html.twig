{% if app.request.query.get('errmes') %}
    <div class="alert alert-danger">
        {{ app.request.query.get('errmes') }}
    </div>
{% endif %}

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">{{ 'Configure local pickup'|trans({}, 'localpickup.bo.default') }}</h5>
    </div>
    <div class="card-body">
        {{ form_start(form, {action: path('localpickup.configure'), method: 'POST'}) }}

            {{ form_errors(form) }}

            <div class="row">
                <div class="col-md-6 mb-3">
                    {{ form_label(form.price) }}
                    <div class="input-group">
                        {{ form_widget(form.price, {attr: {class: 'form-control' ~ (form.price.vars.errors|length ? ' is-invalid' : '')}}) }}
                        <span class="input-group-text">€</span>
                    </div>
                    {% if form.price.vars.errors|length %}
                        <div class="invalid-feedback d-block">{{ form_errors(form.price) }}</div>
                    {% endif %}
                </div>

                <div class="col-md-12 mb-3">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description, {attr: {class: 'form-control' ~ (form.description.vars.errors|length ? ' is-invalid' : ''), rows: 5}}) }}
                    {% if form.description.vars.errors|length %}
                        <div class="invalid-feedback d-block">{{ form_errors(form.description) }}</div>
                    {% endif %}
                </div>

                <div class="col-md-12 mb-3">
                    {{ form_label(form.email) }}
                    {{ form_widget(form.email, {attr: {class: 'form-control' ~ (form.email.vars.errors|length ? ' is-invalid' : ''), rows: 5}}) }}
                    {% if form.email.vars.errors|length %}
                        <div class="invalid-feedback d-block">{{ form_errors(form.email) }}</div>
                    {% endif %}
                </div>

                <div class="col-md-12 mb-3">
                    <div class="form-check">
                        {{ form_widget(form.sms, {attr: {class: 'form-check-input'}}) }}
                        {{ form_label(form.sms, null, {label_attr: {class: 'form-check-label'}}) }}
                    </div>
                    <p class="form-text">{{ 'For SMS to work, please see <a target="_new" href="%url">%url</a> for required additional configuration'|trans({'%url': 'https://symfony.com/doc/current/notifier.html#sms-channel'}, 'localpickup.bo.default')|raw }}</p>
                </div>
            </div>

            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i>
                    {{ 'Save changes'|trans({}, 'localpickup.bo.default') }}
                </button>
                <a href="{{ path('admin.module.configure', {module_code: 'LocalPickup'}) }}" class="btn btn-secondary">
                    <i class="bi bi-x-lg"></i>
                    {{ 'Close'|trans({}, 'localpickup.bo.default') }}
                </a>
            </div>

        {{ form_end(form) }}
    </div>
</div>
